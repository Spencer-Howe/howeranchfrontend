---
// Logo, menu (from src/data/site.ts) and the Book Now button. Desktop: dropdowns open on hover or
// keyboard focus. Phones: one "Menu" button that opens the full list. No JavaScript needed.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.jpg';
import { menu, BOOKING_SITE } from '../data/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === path;
---
<header class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="Howe Ranch home">
      <Image src={logo} alt="Howe Ranch, Kalispell, Montana" width={64} height={60} layout="fixed" loading="eager" />
      <span>Howe Ranch</span>
    </a>

    <nav class="desktop" aria-label="Main">
      <ul>
        {menu.map((item) =>
          'items' in item ? (
            <li class="group">
              <button type="button" aria-haspopup="true">{item.label} <span aria-hidden="true">▾</span></button>
              <ul>
                {item.items.map((l) => (
                  <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          )
        )}
      </ul>
    </nav>

    <a class="book" href={BOOKING_SITE}>Book Now</a>

    <details class="mobile">
      <summary>Menu</summary>
      <nav aria-label="Main">
        <ul>
          {menu.flatMap((item) => ('items' in item ? item.items : [item])).map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li><a class="book-mobile" href={BOOKING_SITE}>Book Now</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: #fff;
    background: rgba(39, 33, 30, .9);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid rgba(208, 172, 104, .28);
    view-transition-name: site-header;   /* stays still while pages cross-fade */
  }
  /* A soft shadow fades in once the page scrolls (CSS scroll-driven animation) */
  @supports (animation-timeline: scroll()) {
    .site-header { animation: header-shadow linear both; animation-timeline: scroll(); animation-range: 0 120px; }
    @keyframes header-shadow { to { box-shadow: 0 10px 30px -12px rgba(0, 0, 0, .45); background: rgba(33, 28, 25, .96); } }
  }
  .bar {
    width: var(--page);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 76px;
  }
  .brand { display: flex; align-items: center; gap: 14px; color: #fff; text-decoration: none; flex-shrink: 0; }
  .brand :global(img) {
    border-radius: 50%; width: 50px; height: 50px; object-fit: cover; background: #fff;
    box-shadow: 0 0 0 2px rgba(208, 172, 104, .85), 0 4px 14px rgba(0, 0, 0, .35);
    transition: transform .4s var(--ease);
  }
  .brand:hover :global(img) { transform: rotate(-6deg) scale(1.04); }
  .brand span { font: 300 1.12rem 'Poppins', sans-serif; letter-spacing: .26em; text-transform: uppercase; }

  nav.desktop { margin-left: auto; }
  nav.desktop > ul { display: flex; gap: 0; list-style: none; margin: 0; padding: 0; }
  nav.desktop a, nav.desktop button {
    position: relative;
    display: block;
    color: #efe7dc;
    text-decoration: none;
    font: 500 .9rem 'Jost', sans-serif;
    letter-spacing: .05em;
    padding: 12px 12px;
    background: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
    transition: color .2s;
  }
  nav.desktop > ul > li > a::after, nav.desktop > ul > li > button::after {
    content: '';
    position: absolute;
    left: 12px; right: 12px; bottom: 6px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform .3s var(--ease);
  }
  nav.desktop > ul > li:hover > a::after, nav.desktop > ul > li:hover > button::after,
  nav.desktop > ul > li > a[aria-current]::after { transform: scaleX(1); }
  nav.desktop a:hover, nav.desktop button:hover, nav.desktop a[aria-current] { color: var(--gold); }
  nav.desktop button span { display: inline-block; font-size: .7em; margin-left: 2px; opacity: .7; transition: transform .25s; }
  .group:hover button span, .group:focus-within button span { transform: rotate(180deg); }

  .group { position: relative; }
  .group ul {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    min-width: 230px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: rgba(255, 253, 249, .98);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 24px 50px -18px rgba(0, 0, 0, .4);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition: opacity .22s, transform .22s var(--ease), visibility 0s .22s;
  }
  .group ul::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px; } /* hover bridge */
  .group:hover ul, .group:focus-within ul { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
  .group ul a { color: var(--brown); border-radius: 9px; padding: 10px 14px; letter-spacing: .02em; font-size: .95rem; }
  .group ul a:hover, .group ul a[aria-current] { background: var(--sand); color: var(--brown); }

  .book {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #dcbb7c, var(--gold-dark));
    color: var(--brown);
    font-weight: 600;
    letter-spacing: .04em;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .35) inset, 0 8px 20px -10px rgba(208, 172, 104, .9);
    transition: transform .25s var(--ease), box-shadow .25s;
  }
  .book::after {   /* a slow shine across the button on hover */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, .45) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform .7s var(--ease);
  }
  .book:hover { color: var(--brown); transform: translateY(-1px); box-shadow: 0 1px 0 rgba(255, 255, 255, .35) inset, 0 12px 26px -10px rgba(208, 172, 104, 1); }
  .book:hover::after { transform: translateX(120%); }

  details.mobile { display: none; margin-left: auto; }
  details.mobile summary {
    list-style: none;
    cursor: pointer;
    padding: 9px 16px;
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: 999px;
    font-weight: 500;
    letter-spacing: .04em;
    transition: background .2s, border-color .2s;
  }
  details.mobile[open] summary { background: rgba(255, 255, 255, .12); border-color: var(--gold); }
  details.mobile summary::-webkit-details-marker { display: none; }
  details.mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: calc(100dvh - 76px);
    overflow-y: auto;
    background: #211c19;
    padding: 12px 24px 32px;
    border-top: 1px solid rgba(208, 172, 104, .2);
  }
  details.mobile[open] nav { animation: sheet .3s var(--ease); }
  @keyframes sheet { from { opacity: 0; transform: translateY(-8px); } }
  details.mobile ul { list-style: none; margin: 0 auto; padding: 0; max-width: 520px; }
  details.mobile li { animation: sheet .4s var(--ease) both; }
  details.mobile li:nth-child(n + 2) { animation-delay: .03s; }
  details.mobile li:nth-child(n + 4) { animation-delay: .06s; }
  details.mobile li:nth-child(n + 7) { animation-delay: .09s; }
  details.mobile li:nth-child(n + 10) { animation-delay: .12s; }
  details.mobile a {
    display: block;
    color: #efe7dc;
    text-decoration: none;
    padding: 14px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, .08);
    font: 200 1.35rem 'Poppins', sans-serif;
    letter-spacing: .02em;
  }
  details.mobile a[aria-current] { color: var(--gold); }
  details.mobile .book-mobile {
    margin-top: 20px; text-align: center; border: 0; border-radius: 999px; padding: 14px;
    background: linear-gradient(180deg, #dcbb7c, var(--gold-dark)); color: var(--brown); font: 600 1.05rem 'Jost', sans-serif;
  }

  @media (max-width: 1080px) {
    nav.desktop { display: none; }
    details.mobile { display: block; }
    .book { margin-left: auto; }
    details.mobile { margin-left: 0; }
  }
  @media (max-width: 420px) {
    .brand span { display: none; }
  }
</style>

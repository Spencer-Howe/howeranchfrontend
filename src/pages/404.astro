---
import Base from '../layouts/Base.astro';
import { BOOKING_SITE } from '../data/site';
---
<Base title="Page not found" hidden>
  <article class="content" style="text-align:center">
    <h1>We couldn't find that page</h1>
    <p>It may have moved when we updated our website.</p>
    <div class="buttons">
      <a class="button" href="/">Go to the home page</a>
      <a class="button gold" href={BOOKING_SITE}>Book an experience</a>
    </div>
  </article>
</Base>
